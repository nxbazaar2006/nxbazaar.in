  transactions  WalletTransaction[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([sellerId])
  @@index([walletId])
  @@index([status])
  @@index([approvedById])
}

model AuditLog {
