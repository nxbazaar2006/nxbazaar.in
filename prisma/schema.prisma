model WalletTransaction {
  id            String        @id @default(uuid())
  walletId      String
  wallet        SellerWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  sellerOrderId String?
  sellerOrder   SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  payoutId      String?
  payout        SellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorId       String?
