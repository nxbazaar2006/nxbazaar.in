  type          String
  amount        Float
  balanceAfter  Float
  description   String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  @@index([walletId])
  @@index([sellerOrderId])
  @@index([payoutId])
  @@index([actorId])
}

model SellerPayout {
  id            String              @id @default(uuid())
  sellerId      String
