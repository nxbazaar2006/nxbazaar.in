  summary     String
  data        Json
  severity    String?
  status      String    @default("ACTIVE")
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([scope])
  @@index([insightType])
  @@index([status])
  @@index([createdAt])
}

model ProductQrScan {
  id          String   @id @default(uuid())
  productId   String
  variantId   String?
  productCode String
  sku         String?
  userId      String?
  source      String?
  userAgent   String?
  ipHash      String?
  scannedAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([productCode])
  @@index([sku])
  @@index([scannedAt])
}

model ProductSequence {
  prefix       String   @id
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("product_sequences")
}

model BarcodeSequence {
  id           String   @id @default("barcode")
  lastSequence BigInt   @default(100000000000)
  updatedAt    DateTime @updatedAt

  @@map("barcode_sequences")
}



