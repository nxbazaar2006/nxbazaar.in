  @@unique([cartId, productId, productVariantId])
  @@index([productId])
  @@index([productVariantId])
}

model Wishlist {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@unique([userId, productId, productVariantId])
  @@index([productId])
  @@index([productVariantId])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  label         String?
  firstName     String
  lastName      String?
  phone         String
  email         String?
  streetAddress String
  apartment     String?
  city          String
  state         String
  country       String
  postalCode    String
  isDefault     Boolean  @default(false)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Order {
  id            String        @id @default(uuid())
  userId        String
  // Personal Details
  firstName     String
  lastName      String
  email         String
  phone         String
  // shipping details
  streetAddress String?
  city          String?
  country       String?
  apartment     String?
  state         String?
  zip           String?
  shippingCost  Float?
  orderNumber   String?
  couponId      String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  addressId     String?
  address       Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  //Payment Method
  paymentMethod String
  paymentStatus PaymentStatus @default(PENDING)
  subtotal      Float         @default(0)
  discountTotal Float         @default(0)
  taxableTotal  Float         @default(0)
  cgstTotal     Float         @default(0)
  sgstTotal     Float         @default(0)
  igstTotal     Float         @default(0)
  taxTotal      Float         @default(0)
  grandTotal    Float         @default(0)

  // Order Items
  orderItems   OrderItem[]
  sellerOrders SellerOrder[]
  payments     Payment[]
  shipments    Shipment[]

  // Status
  orderStatus OrderStatus @default(PROCESSING) // Set PROCESSING as the default value
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sales       Sale[]

  @@index([userId])
  @@index([couponId])
  @@index([addressId])
  @@index([orderStatus])
  @@index([paymentStatus])
}

model OrderItem {
  id                     String          @id @default(uuid())
  orderId                String
  sellerOrderId          String?
  productId              String
  productVariantId       String?
  vendorId               String
  imageUrl               String?
  title                  String?
  selectedAttributes     Json?
  variantId              String?
  productCode            String?
  sku                    String?
  barcode                String?
  quantity               Int
  price                  Float
  regularPrice           Float?
  salePrice              Float?
  subtotal               Float           @default(0)
  discount               Float           @default(0)
  taxableValue           Float           @default(0)
  hsnCode                String?
  hsnDescription         String?
  hsnDescriptionSnapshot String?
  hsnSource              String?
  gstRate                Float?
  taxTreatmentSnapshot   TaxTreatment?
  cgstRate               Float?
  sgstRate               Float?
  igstRate               Float?
  cessRate               Float?
  cgstAmount             Float           @default(0)
  sgstAmount             Float           @default(0)
  igstAmount             Float           @default(0)
  cessAmount             Float           @default(0)
  taxAmount              Float           @default(0)
  commissionRate         Float?
  commissionAmount       Float           @default(0)
  sellerPayable          Float           @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  order                  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sellerOrder            SellerOrder?    @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product                Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productVariant         ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([vendorId])
  @@index([productVariantId])
}

model SellerOrder {
  id                 String              @id @default(uuid())
  orderId            String
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sellerId           String
  seller             User                @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderNumber        String?
  status             SellerOrderStatus   @default(PENDING)
  itemSubtotal       Float               @default(0)
  discountTotal      Float               @default(0)
  taxableTotal       Float               @default(0)
  cgstTotal          Float               @default(0)
  sgstTotal          Float               @default(0)
  igstTotal          Float               @default(0)
  shippingTotal      Float               @default(0)
  commissionTotal    Float               @default(0)
  sellerPayable      Float               @default(0)
  orderItems         OrderItem[]
  shipments          Shipment[]
  walletTransactions WalletTransaction[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([orderId, sellerId])
  @@index([sellerId])
  @@index([status])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  provider      String
  method        String?
  transactionId String?       @unique
  status        PaymentStatus @default(PENDING)
  amount        Float
  currency      String        @default("INR")
  rawResponse   Json?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model Shipment {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sellerOrderId  String?
  sellerOrder    SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sellerId       String?
  seller         User?        @relation(fields: [sellerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  status         String       @default("PENDING")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([sellerId])
}

model Review {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  rating           Int
  title            String?
  comment          String?
  isApproved       Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([isApproved])
}

model Sale {
  id               String          @id @default(uuid())
  orderId          String
  productId        String
  productVariantId String?
  variantId        String?
  vendorId         String
  total            Float
  productTitle     String
  productImage     String
  productPrice     Float
  productQty       Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  vendor           User            @relation(fields: [vendorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productVariantId])
}

model SellerCommission {
  id         String    @id @default(uuid())
  sellerId   String?
  seller     User?     @relation(fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoryId String?
